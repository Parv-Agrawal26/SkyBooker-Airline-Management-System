{
  "info": {
    "name": "SkyBooker Complete API Tests",
    "description": "Postman collection covering all microservices in the SkyBooker application. Includes automatic JWT handling.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Auth Service",
      "item": [
        {
          "name": "POST /auth/register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"System Admin\",\n  \"email\": \"admin@skybooker.com\",\n  \"password\": \"secret123\",\n  \"phone\": \"1234567890\",\n  \"passportNumber\": \"A12345678\",\n  \"nationality\": \"USA\"\n}"
            },
            "url": { "raw": "http://localhost:8080/auth/register", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["auth", "register"] }
          }
        },
        {
          "name": "POST /auth/login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set(\"jwt_token\", jsonData.token);",
                  "    console.log(\"Token automatically saved!\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@skybooker.com\",\n  \"password\": \"secret123\"\n}"
            },
            "url": { "raw": "http://localhost:8080/auth/login", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["auth", "login"] }
          }
        },
        {
          "name": "GET /auth/profile",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:8080/auth/profile", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["auth", "profile"] }
          }
        },
        {
          "name": "GET /auth/users (ADMIN)",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:8080/auth/users", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["auth", "users"] }
          }
        }
      ]
    },
    {
      "name": "2. Airline & Airport Service",
      "item": [
        {
          "name": "POST /airlines",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sky Airlines\",\n  \"iataCode\": \"SA\",\n  \"icaoCode\": \"SKY\",\n  \"country\": \"USA\",\n  \"contactEmail\": \"contact@skyairlines.com\"\n}"
            },
            "url": { "raw": "http://localhost:8080/airlines", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["airlines"] }
          }
        },
        {
          "name": "GET /airlines",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:8080/airlines", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["airlines"] }
          }
        },
        {
          "name": "POST /airports",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John F. Kennedy International\",\n  \"iataCode\": \"JFK\",\n  \"city\": \"New York\",\n  \"country\": \"USA\",\n  \"latitude\": 40.6413,\n  \"longitude\": -73.7781\n}"
            },
            "url": { "raw": "http://localhost:8080/airports", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["airports"] }
          }
        },
        {
          "name": "GET /airports/search",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:8080/airports/search?keyword=New York", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["airports", "search"], "query": [{ "key": "keyword", "value": "New York" }] }
          }
        }
      ]
    },
    {
      "name": "3. Flight Service",
      "item": [
        {
          "name": "POST /flights",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"flightNumber\": \"SA101\",\n  \"airlineId\": 1,\n  \"originAirportCode\": \"JFK\",\n  \"destinationAirportCode\": \"LAX\",\n  \"departureTime\": \"2026-12-01T10:00:00\",\n  \"arrivalTime\": \"2026-12-01T13:00:00\",\n  \"durationMinutes\": 300,\n  \"status\": \"ON_TIME\",\n  \"aircraftType\": \"Boeing 737\",\n  \"totalSeats\": 150,\n  \"availableSeats\": 150,\n  \"basePrice\": 299.99\n}"
            },
            "url": { "raw": "http://localhost:8080/flights", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["flights"] }
          }
        },
        {
          "name": "GET /flights/all",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:8080/flights/all", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["flights", "all"] }
          }
        },
        {
          "name": "GET /flights/search",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:8080/flights/search?origin=JFK&dest=LAX&date=2026-12-01", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["flights", "search"], "query": [{ "key": "origin", "value": "JFK" }, { "key": "dest", "value": "LAX" }, { "key": "date", "value": "2026-12-01" }] }
          }
        }
      ]
    },
    {
      "name": "4. Seat Service",
      "item": [
        {
          "name": "POST /seats/add",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"flightId\": 1,\n    \"seatNumber\": \"12A\",\n    \"seatClass\": \"ECONOMY\",\n    \"rowNum\": 12,\n    \"columnLetter\": \"A\",\n    \"isWindow\": true,\n    \"isAisle\": false,\n    \"hasExtraLegroom\": false,\n    \"priceMultiplier\": 1.0\n  }\n]"
            },
            "url": { "raw": "http://localhost:8080/seats/add", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["seats", "add"] }
          }
        },
        {
          "name": "GET /seats/flight/{flightId}",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:8080/seats/flight/1", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["seats", "flight", "1"] }
          }
        },
        {
          "name": "PUT /seats/hold",
          "request": {
            "method": "PUT",
            "header": [{ "key": "X-User-Id", "value": "1" }],
            "url": { "raw": "http://localhost:8080/seats/hold?flightId=1&seatNumber=12A", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["seats", "hold"], "query": [{ "key": "flightId", "value": "1" }, { "key": "seatNumber", "value": "12A" }] }
          }
        }
      ]
    },
    {
      "name": "5. Passenger Service",
      "item": [
        {
          "name": "POST /passengers",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingId\": \"00000000-0000-0000-0000-000000000001\",\n  \"title\": \"Ms\",\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Smith\",\n  \"dateOfBirth\": \"1990-05-15\",\n  \"gender\": \"FEMALE\",\n  \"passportNumber\": \"A12345678\",\n  \"passportExpiry\": \"2030-05-15\",\n  \"nationality\": \"USA\"\n}"
            },
            "url": { "raw": "http://localhost:8080/passengers", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["passengers"] }
          }
        },
        {
          "name": "GET /passengers/{id}",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:8080/passengers/1", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["passengers", "1"] }
          }
        }
      ]
    },
    {
      "name": "6. Booking Service",
      "item": [
        {
          "name": "POST /bookings",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1,\n  \"flightId\": 1,\n  \"passengerIds\": [1],\n  \"seatIds\": [1],\n  \"totalAmount\": 299.99\n}"
            },
            "url": { "raw": "http://localhost:8080/bookings", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["bookings"] }
          }
        },
        {
          "name": "POST /bookings/{bookingId}/pay",
          "request": {
            "method": "POST",
            "url": { "raw": "http://localhost:8080/bookings/00000000-0000-0000-0000-000000000001/pay?method=CREDIT_CARD", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["bookings", "00000000-0000-0000-0000-000000000001", "pay"], "query": [{ "key": "method", "value": "CREDIT_CARD" }] }
          }
        },
        {
          "name": "GET /bookings/user/{userId}",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:8080/bookings/user/1", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["bookings", "user", "1"] }
          }
        }
      ]
    },
    {
      "name": "7. Payment Service",
      "item": [
        {
          "name": "POST /payments/initiate",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingId\": \"00000000-0000-0000-0000-000000000001\",\n  \"userId\": 1,\n  \"amount\": 299.99,\n  \"currency\": \"USD\",\n  \"paymentMethod\": \"CREDIT_CARD\"\n}"
            },
            "url": { "raw": "http://localhost:8080/payments/initiate", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["payments", "initiate"] }
          }
        },
        {
          "name": "GET /payments/user/{userId}",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:8080/payments/user/1", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["payments", "user", "1"] }
          }
        }
      ]
    },
    {
      "name": "8. Notification Service",
      "item": [
        {
          "name": "GET /notifications/all",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:8080/notifications/all", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["notifications", "all"] }
          }
        },
        {
          "name": "GET /notifications/user/{recipientId}",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:8080/notifications/user/1", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["notifications", "user", "1"] }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "jwt_token",
      "value": ""
    }
  ]
}

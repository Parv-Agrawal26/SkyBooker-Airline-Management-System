# =============================================================
# SkyBooker - Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================

# ── JWT (shared across ALL services — must be identical) ─────
JWT_SECRET=<your-strong-random-secret-min-32-chars>
JWT_EXPIRATION=86400000

# ── Database (set per service or use separate DB_URL per service) ─
DB_USERNAME=<db-username>
DB_PASSWORD=<db-password>

# Auth service DB
AUTH_DB_URL=jdbc:mysql://<host>:3306/skybooker_auth_db

# Flight service DB
FLIGHT_DB_URL=jdbc:mysql://<host>:3306/skybooker_flight_db

# Booking service DB
BOOKING_DB_URL=jdbc:mysql://<host>:3306/skybooker_booking_db

# Payment service DB
PAYMENT_DB_URL=jdbc:mysql://<host>:3306/skybooker_payment_db

# Passenger service DB
PASSENGER_DB_URL=jdbc:mysql://<host>:3306/skybooker_passenger_db

# Seat service DB
SEAT_DB_URL=jdbc:mysql://<host>:3306/skybooker_seat_db

# Airline service DB
AIRLINE_DB_URL=jdbc:mysql://<host>:3306/skybooker_airline_db

# ── RabbitMQ ──────────────────────────────────────────────────
RABBITMQ_HOST=<rabbitmq-host>
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=<rabbitmq-username>
RABBITMQ_PASSWORD=<rabbitmq-password>

# ── Google OAuth ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=<your-google-oauth-client-id>

# ── Admin / Staff secret keys (auth-service) ─────────────────
ADMIN_SECRET_KEY=<strong-admin-secret>
STAFF_SECRET_KEY=<strong-staff-secret>

# ── Razorpay (payment-service) ────────────────────────────────
RAZORPAY_KEY_ID=<razorpay-key-id>
RAZORPAY_KEY_SECRET=<razorpay-key-secret>

# ── Email / SMTP (notification-service) ──────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=<your-email@gmail.com>
MAIL_PASSWORD=<your-gmail-app-password>
MAIL_FROM=SkyBooker <<your-email@gmail.com>>

# ── Internal service URLs (production — use real hostnames) ───
AUTH_SERVICE_URL=http://auth-service:8081
FLIGHT_SERVICE_URL=http://flight-service:8082
BOOKING_SERVICE_URL=http://booking-service:8083
PASSENGER_SERVICE_URL=http://passenger-service:8084
PAYMENT_SERVICE_URL=http://payment-service:8085
SEAT_SERVICE_URL=http://seat-service:8086
AIRLINE_SERVICE_URL=http://airline-service:8087

# ── Frontend CORS origin ──────────────────────────────────────
FRONTEND_URL=https://<your-frontend-domain>

# ── Feature flags ─────────────────────────────────────────────
SWAGGER_ENABLED=false
JPA_SHOW_SQL=false
LOG_LEVEL=INFO
